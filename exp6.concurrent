module example2;

  bit a, b;
  bit clk = 0;

  always #5 clk = ~clk;

  initial begin
    for (int i = 0; i < 10; i++) begin
      @(posedge clk);
      a = $random;
      b = $random;
      $display("a=%0d, b=%0d", a, b);
    end
    #10 $finish;
  end

  property p;
    @(posedge clk) (a && b);
  endproperty

  assert property(p)
    else $fatal("Assertion failed");

endmodule
