module sequence_detector (
  input  bit clk,
  input  bit rst,
  input  bit in,
  output bit out
);

  typedef enum bit [2:0] {
    S0, S1, S2, S3, S4
  } state_t;

  state_t present, next;

  // State transition
  always_ff @(posedge clk or posedge rst) begin
    if (rst)
      present <= S0;
    else
      present <= next;
  end

  // Next state logic
  always_comb begin
    case (present)
      S0: next = (in) ? S1 : S0;
      S1: next = (in) ? S1 : S2;
      S2: next = (in) ? S3 : S0;
      S3: next = (in) ? S4 : S2;
      S4: next = (in) ? S1 : S2;
      default: next = S0;
    endcase
  end

  // Output logic (Mealy type)
  always_comb begin
    if (present == S3 && in == 1)
      out = 1;
    else
      out = 0;
  end

endmodule
